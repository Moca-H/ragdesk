# Copy to .env next to start.cmd and edit.

# Listen address: 127.0.0.1 = local only; 0.0.0.0 = LAN
RAGDESK_HOST=0.0.0.0
RAGDESK_PORT=8000

# Optional API protection (UI Settings page stores the same token in the browser)
# RAGDESK_API_TOKEN=change-me

# Lock Provider / model fields in the UI (use with server-side preconfig below)
# RAGDESK_LOCK_SETTINGS=1

# Preconfigure model (optional)
RAGDESK_PROVIDER=mock
# RAGDESK_BASE_URL=https://api.openai.com/v1
# RAGDESK_API_KEY=sk-...
# RAGDESK_CHAT_MODEL=gpt-4o-mini
# RAGDESK_EMBEDDING_MODEL=text-embedding-3-small
# RAGDESK_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Extra browser origins if the UI is opened from another host/port (comma-separated)
# RAGDESK_CORS_ORIGINS=http://192.168.1.10:8000
