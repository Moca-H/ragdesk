# Copy to .env for Docker Compose or local API.

# --- Security ---
# RAGDESK_API_TOKEN=change-me
# RAGDESK_LOCK_SETTINGS=1

# --- Provider (server-side preconfig) ---
RAGDESK_PROVIDER=mock
# RAGDESK_BASE_URL=https://api.openai.com/v1
# RAGDESK_API_KEY=sk-...
# RAGDESK_CHAT_MODEL=gpt-4o-mini
# RAGDESK_EMBEDDING_MODEL=text-embedding-3-small
# RAGDESK_OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Portable package only (ignored by Docker web container) ---
# RAGDESK_HOST=0.0.0.0
# RAGDESK_PORT=8000

# Extra CORS origins (comma-separated), e.g. http://192.168.1.10:8000
# RAGDESK_CORS_ORIGINS=
